rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /cnisAnalyses/{analysisId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'fileName', 'createdAt', 'summary',
          'tempoContribuicaoTotal', 'carenciaTotal', 'qualityScore', 'analysis'
        ])
        && request.resource.data.uid is string
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 80
        && request.resource.data.createdAt is timestamp
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 3000
        && request.resource.data.tempoContribuicaoTotal is string
        && request.resource.data.tempoContribuicaoTotal.size() <= 120
        && request.resource.data.carenciaTotal is number
        && request.resource.data.carenciaTotal >= 0
        && request.resource.data.carenciaTotal <= 1000
        && request.resource.data.qualityScore is number
        && request.resource.data.qualityScore >= 0
        && request.resource.data.qualityScore <= 100
        && request.resource.data.analysis is map
        && request.resource.data.analysis.size() <= 40;
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
